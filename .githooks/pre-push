#!/bin/sh
# לפני כל push: הבדיקה האוטומטית של האתר (checks/site-check.js).
# אם היא נכשלת, ה-push נעצר. הפירוט ב-checks/output/report.txt
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d node_modules/playwright ]; then
  echo "חסרה ההתקנה של הבדיקה: npm install && npx playwright install chromium webkit firefox"
  exit 1
fi
npm run check
